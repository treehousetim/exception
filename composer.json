{
    "name": "treehousetim/exception",
    "description": "Simple Good Exceptions",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tim Gallagher",
            "email": "treehousetim@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "treehousetim\\exception\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "treehousetim\\exception\\test\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "phpunit"
        ]
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        }
    }
}
